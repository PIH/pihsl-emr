    <style type="text/css">
        .simple-form-ui input {
            min-width: 80%
        }

    </style>

    <script type="text/javascript">

        jq(function() {

            // make text areas expand based on content (this allows us to avoid scrollbars and thereby facilitate printing)
            jq('#post-op-surgical-note').on( 'keyup', 'textarea', function (){
                jq(this).height( 0 );
                jq(this).height( this.scrollHeight );
                });

            jq('#post-op-surgical-note').find( 'textarea' ).keyup();

        });

    </script>

    <ifMode mode="VIEW" include="false" >
        <h2>
            <label>
                <uimessage code="surgical_note"/>
            </label>
        </h2>
    </ifMode>

    <div class="print-form-datestamps" style="display:none">
        <p><uimessage code="created_on"/>:
            <lookup complexExpression="$form.dateCreated"/>
        </p>
        <p><uimessage code="last_updated_on"/>:
            <lookup complexExpression="$form.dateChanged"/>
        </p>
        <p><uimessage code="printed_on"/>:
            <lookup complexExpression="$formGeneratedDatetime"/>
        </p>
    </div>

    <ifMode mode="VIEW" include="false">
        <table>
            <tr>
                <td>
                    <label style="color:red">
                        <b>
                            <uimessage code="pihcore.cSectionFromSurgery" />
                        </b>
                    </label>
                </td>
            </tr>
        </table>
    </ifMode>

    <section id="service-team" sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="service_team">
        <div class="section-container">
            <p>
                <label>
                    <uimessage code="date"/>
                </label>
                <encounterDate id="encounterDate" default="now"/>
            </p>

            <p>
                <label>
                    <uimessage code="location"/>
                </label>
                <encounterLocation default="SessionAttribute:emrContext.sessionLocationId"
                                   tags="Surgery Note Location"/>
            </p>

            <p>
                <label>
                    <uimessage code="surgical_service"/>
                </label>
                <obs conceptId="PIH:Surgical service"/>
            </p>

            <p>
                <!-- Attending surgeon -->
                <label>
                    <uimessage code="attending"/>
                </label>
                <encounterProviderAndRole encounterRole="9b135b19-7ebe-4a51-aea2-69a53f9383af"
                                          providerRoles="3182ee51-b895-4804-a342-5f261e995222,556ceee6-d899-43d4-a98b-7973ebc85b75,2fa6f8da-aa58-11e8-98d0-529269fb1459"
                                          autocompleteProvider="true" required="true"/>
            </p>

            <p>
                <!-- Assisting surgeons -->
                <label>
                    <uimessage code="assistants"/>
                </label>
                <div class="provider-grid">
                    <div>
                        <encounterProviderAndRole encounterRole="6e630e03-5182-4cb3-9a82-a5b1a85c09a7"
                                                  providerRoles="3182ee51-b895-4804-a342-5f261e995222,556ceee6-d899-43d4-a98b-7973ebc85b75,2fa6f8da-aa58-11e8-98d0-529269fb1459,e92792de-006a-4dea-b078-cf3776638b0c"
                                                  autocompleteProvider="true" required="false" count="2" providerWidgetSeparator="&lt;/div&gt;&lt;div&gt;"/>
                    </div>
                </div>
            </p>
            <p>
                <!-- Non-coded name of assisting surgeon -->
                <label>
                    <uimessage code="other"/>
                </label>
                <obs conceptId="PIH:Name of assistant surgeon"/>
            </p>

            <p>
                <!-- Anesthesiologists -->
                <label>
                    <uimessage code="anesthesiologist"/>
                </label>
                <div class="provider-grid">
                    <div>
                        <encounterProviderAndRole encounterRole="de11b25c-a641-4630-9524-5b85ece9a4f8"
                                                  providerRoles="39c28f78-6637-4c21-9bf4-db3e2398054f"
                                                  autocompleteProvider="true" required="false" count="2" providerWidgetSeparator="&lt;/div&gt;&lt;div&gt;"/>
                    </div>
                </div>
            </p>

            <p>
                <!-- Nurses -->
                <label>
                    <uimessage code="nurse"/>
                </label>
                <div class="provider-grid">
                    <div>
                        <encounterProviderAndRole encounterRole="98bf2792-3f0a-4388-81bb-c78b29c0df92"
                                                  providerRoles="7207ba62-027f-4f9b-be67-a9f7a8a3abcc"
                                                  autocompleteProvider="true" required="false" count="2" providerWidgetSeparator="&lt;/div&gt;&lt;div&gt;"/>
                    </div>
                </div>
            </p>
        </div>
    </section>

    <section id="description" sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="Description">

        <div class="section-container two-columns">
            <div>
                <p class="list-inline">
                    <label>
                        <uimessage code="admission_status"/>
                    </label>
                    <obs conceptId="PIH:TYPE OF PATIENT" style="radio"
                         answerConceptIds="PIH:AMBULATORY,PIH:INPATIENT HOSPITALIZATION"
                         answerSeparator=""/>
                </p>

                <!-- Pregnancy group -->
                <subform path="configuration/pih/subforms/pregnancy-group-view-only-widget.xml"/>

                <p class="list-inline">
                    <label>
                        <uimessage code="emergency"/>
                    </label>
                    <obs conceptId="PIH:Emergency" style="radio" answerConceptIds="PIH:YES,PIH:NO"
                         answerCodes="yes,no" answerSeparator=""/>
                </p>

                <p>
                    <label>
                        <uimessage code="pre_op_diagnoses"/>
                    </label>
                    <obs class="autocomplete" conceptId="PIH:Pre-surgery diagnosis"
                         answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete"/>
                    <obs conceptId="PIH:Pre-surgery diagnosis" answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding"
                         style="autocomplete"/>
                    <obs conceptId="PIH:Pre-surgery diagnosis" answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding"
                         style="autocomplete"/>
                </p>

                <p>
                    <label>
                        <uimessage code="procedures"/>
                    </label>
                    <obs conceptId="PIH:Surgical procedure" answerClasses="Procedure" style="autocomplete"/>
                    <obs conceptId="PIH:Surgical procedure" answerClasses="Procedure" style="autocomplete"/>
                    <obs conceptId="PIH:Surgical procedure" answerClasses="Procedure" style="autocomplete"/>
                    <obs conceptId="PIH:Surgical procedure" answerClasses="Procedure" style="autocomplete"/>
                    <obs conceptId="PIH:Surgical procedure" answerClasses="Procedure" style="autocomplete"/>
                </p>
            </div>

            <div>
                <p class="list-inline">
                    <label>
                        <uimessage code="planned_return_or"/>
                    </label>
                    <obs conceptId="PIH:Planned return to operating room" style="radio"
                         answerConceptIds="PIH:YES,PIH:NO"
                         answerCodes="yes,no" answerSeparator=""/>
                </p>

                <p class="list-inline">
                    <label>
                        <uimessage code="scheduled"/>
                    </label>
                    <obs conceptId="PIH:Scheduled surgery" style="radio" answerConceptIds="PIH:YES,PIH:NO"
                         answerCodes="yes,no" answerSeparator=""/>
                </p>

                <p>
                    <label>
                        <uimessage code="post_op_diagnoses"/>
                    </label>
                    <obs conceptId="PIH:Post-surgery diagnosis"
                         answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete"/>
                    <obs conceptId="PIH:Post-surgery diagnosis"
                         answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete"/>
                    <obs conceptId="PIH:Post-surgery diagnosis"
                         answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete"/>
                </p>

                <p class="list-inline">
                    <label>
                        <uimessage code="anesthesia"/>
                    </label>
                    <br/>
                    <obs conceptId="PIH:Type of anesthesia" style="radio"
                         answerConceptIds="PIH:7850,PIH:7854,PIH:7855,PIH:7856,PIH:7852,PIH:7853,PIH:7851,PIH:21112,PIH:1107"
                         answerSeparator="&lt;br /&gt;"/>
                </p>
                <p>
                    <label>
                        <uimessage code="Complications from anaesthesia"/>
                    </label>
                    <obs conceptId="$complicationsFromAnesthesia"/>
                </p>

                <p class="list-inline">
                    <label>
                        <uimessage code="wound_class"/>
                    </label>
                    <br/>
                    <obs conceptId="PIH:Classifications of surgical wounds" style="radio"/>
                </p>
            </div>
        </div>
    </section>

    <section id="ins-outs" sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="ins_outs">

        <div class="section-container two-columns">
            <div>
                <h3>
                    <uimessage code="fluids_admin"/>
                </h3>

                    <label>
                        <uimessage code="ivf"/>
                    </label>
                    <repeat>
                        <template>
                            <p class="list-inline">
                                <obsgroup groupingConceptId="PIH:IVF construct" showIfEmpty="false">
                                    <obs conceptId="PIH:IVF administered" style="checkbox"
                                         answerConceptId="CIEL:{ivfId}"/>
                                    <span class="small">
                                        <obs conceptId="PIH:21113" showUnits="true"/>
                                    </span>
                                </obsgroup>
                            </p>
                        </template>
                        <render ivfId="74653"/>
                        <render ivfId="161922"/>
                        <render ivfId="161923"/>
                        <render ivfId="74653"/>
                        <render ivfId="161924"/>
                        <render ivfId="78617"/>
                        <render ivfId="80804"/>
                    </repeat>

                <p class="list-inline">
                    <label>
                        <uimessage code="transfusion"/>
                    </label>
                    <br/>
                    <obs id="transfusion" conceptId="PIH:Transfusion status" style="radio"
                         answerConceptIds="PIH:YES,PIH:NO" answerCodes="yes,no"
                         answerSeparator="">
                        <controls>
                            <when value="PIH:YES" thenDisplay="#type-transfusion" />
                        </controls>
                    </obs>
                </p>

                <div id="type-transfusion">
                    <p>
                        <label>
                            <uimessage code="if blood transfusion, specify type and volume:"/>
                        </label>

                        <repeat>
                            <template>
                                <p class="list-inline">
                                    <obsgroup groupingConceptId="PIH:Transfusion construct" showIfEmpty="false">
                                        <obs conceptId="PIH:Transfusion of fluid" answerConceptId="PIH:{transId}"/>
                                        <span class="small">
                                            <obs conceptId="PIH:Volume of transfusion" showUnits="true"/>
                                        </span>
                                    </obsgroup>
                                </p>
                            </template>
                            <render transId="Whole blood" />
                            <render transId="Packed red blood cells" />
                            <render transId="Plasma" />
                            <render transId="Platelets" />
                        </repeat>

                    </p>

                </div>
            </div>

            <div>
                <p class="list-inline-wide">
                    <label>
                        <uimessage code="pre_op_antibiotic"/>
                    </label>
                    <obs id="pre-op-antibiotic"
                         conceptId="PIH:Pre-operative antibiotic administered" style="radio"
                         answerConceptIds="PIH:YES,PIH:NO" answerCodes="yes,no">
                        <controls>
                            <when value="PIH:YES" thenDisplay="#pre-antibiotic-name"/>
                        </controls>
                    </obs>
                </p>
                <p id="pre-antibiotic-name">
                    <label>
                        <uimessage code="antibiotic_name"/>
                    </label>
                    <repeat>
                        <template>
                            <obs conceptId="PIH:Surgery antibiotics" style="checkbox"
                                 answerConceptId="CIEL:{antiB}" />
                        </template>
                        <render antiB="450" />
                        <render antiB="71184" />
                        <render antiB="71188" />
                        <render antiB="72998" />
                        <render antiB="73018" />
                        <render antiB="73041" />
                        <render antiB="73239" />
                        <render antiB="73449" />
                        <render antiB="73546" />
                        <render antiB="76488" />
                        <render antiB="100" />
                        <render antiB="81951" />
                    </repeat>

                </p>

                <p class="list-inline-wide">
                    <label>
                        <uimessage code="vtp"/>
                    </label>
                    <br/>
                    <obs conceptId="PIH:Venous thromboembolism prophylaxis"
                         style="radio" answerSeparator="&lt;br /&gt;"/>
                </p>
                <p>
                    <h3>
                        <uimessage code="fluid_out"/>
                    </h3>
                    <label>
                        <uimessage code="est_blood_loss"/>
                    </label>
                    <span class="small">
                        <obs conceptId="PIH:12555" showUnits="true"/>
                    </span>
                    <br/>

                    <label>
                        <uimessage code="urine_out"/>
                    </label>
                    <span class="small">
                        <obs conceptId="CIEL:161929" showUnits="true"/>
                    </span>
                </p>
            </div>
        </div>
    </section>

    <section id="plan" sectionTag="fieldset" headerTag="legend" headerStyle="title" headerCode="Plan">
        <div class="section-container">
            <p>
                <label>
                    <uimessage code="findings"/>
                </label>
                <obs id="additional-comments" conceptId="PIH:Additional Surgery Comments" style="textarea" rows="3"
                     cols="80"/>
            </p>

            <p>
                <label>
                    <uimessage code="Instructions"/>
                </label>
                <obs id="instructions" conceptId="CIEL:163106" style="textarea" rows="3"
                     cols="80"/>
            </p>
            <p>
                <label>
                    <uimessage code="pihcore.baby.observations"/>
                </label>
                <obs conceptId="PIH:21120" style="textarea" rows="3" cols="80"/>
            </p>

            <div class="two-columns">
                <div>
                    <p>
                        <label>
                            <uimessage code="Drainage removal date" />
                        </label>
                        <span class="small">
                            <obs conceptId="PIH:20926" allowFutureDates="true"/>
                        </span>
                    </p>
                </div>
                <div>
                    <p>
                        <label>
                            <uimessage code="Stitches removal date" />
                        </label>
                        <span class="small">
                            <obs conceptId="PIH:20927" allowFutureDates="true"/>
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <br/>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>

</htmlform>
