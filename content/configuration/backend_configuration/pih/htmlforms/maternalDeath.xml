<htmlform formUuid="25485cdd-5cb3-4d91-abc4-029718254954" formName="Maternal Death"
          formEncounterType="415b342e-9e4d-4496-bac4-7b6ffb8619f0" formVersion="1.0">
    <style>
        /* Target the parent p element */
        #health-section-container > p {
            display: flex;
            flex-direction: row;
            align-items: baseline; /* Aligns text baselines of label and span */
            gap: 8px;              /* Adds some space between the label and span */
        }

        /* Ensure the label doesn't take up the full width */
        #health-section-container > p label {
            display: inline;
            width: auto;
        }

        .highlight-facility {
            font-weight: bold;
            color: blue;
        }
    </style>
    <h2>
        <label>
            <uimessage code="pih.task.maternalDeath"/>
        </label>
    </h2>

    <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
        <span subform-parameter="encounter-location-widget">
            <encounterLocation default="SessionAttribute:emrContext.sessionLocationId" tags="Maternal Death Location"/>
        </span>
        <span subform-parameter="encounter-provider-widget">
            <encounterProviderAndRole default="currentUser"
                                      encounterRole="4f10ad1a-ec49-48df-98c7-1391c6ac7f05"
                                      providerRoles="${providerGroup.group2}"
                                      required="true"/>
        </span>
    </subform>

    <!-- Locate the Admission encounter (encounter type "Admission") that belongs to the same visit as this
         Maternal Death encounter, and expose it to the rest of the form as $admissionEncounter.
         In VIEW/EDIT mode the visit is taken from the encounter being viewed/edited; in ENTER mode it is taken
         from the visit the form is being entered into ($visit is an emrapi VisitDomainWrapper).
         If the visit holds more than one Admission encounter, the earliest one is used. -->
    <lookup complexExpression="
        #set($admissionEncounterType = '260566e1-c909-4d61-a96f-c1019291a09d')
        #if($encounter and $encounter.visit)
            #set($maternalDeathVisit = $encounter.visit)
        #elseif($visit and $visit.visit)
            #set($maternalDeathVisit = $visit.visit)
        #end
        #if($maternalDeathVisit)
            #foreach($visitEncounter in $maternalDeathVisit.nonVoidedEncounters)
                #if($visitEncounter.encounterType.uuid == $admissionEncounterType
                    and (!$admissionEncounter
                         or $visitEncounter.encounterDatetime.before($admissionEncounter.encounterDatetime)))
                    #set($admissionEncounter = $visitEncounter)
                #end
            #end
        #end
        #if($admissionEncounter)
            #set($admissionLocation = $admissionEncounter.location)
            #foreach($i in [1..10])
                #if($admissionLocation and $admissionLocation.parentLocation)
                    #set($admissionLocation = $admissionLocation.parentLocation)
                #end
            #end
        #end"/>

    <section id="facilitySection" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Health Facility">
        <div class="section-container" id="health-section-container">
            <p>
                <label><uimessage code="Health facility admitted to:" /></label>
                <span class="highlight-facility"><lookup complexExpression="#if($admissionEncounter) yes #else no #end"/></span>
            </p>
            <p>
                <label><uimessage code="Admitted to health facility:" /></label>
                <span class="highlight-facility"><lookup complexExpression="#if($admissionLocation) $admissionLocation $admissionEncounter.location #end"/></span>
            </p>
            <p>
                <label><uimessage code="Admission date/time:" /></label>
                <span class="highlight-facility"><lookup complexExpression="#if($admissionEncounter)$fn.formatDate($admissionEncounter.encounterDatetime, 'dd MMM yyyy hh:mm a')#end"/></span>
            </p>
            <p>
                <label><uimessage code="Death and time of death:" /></label>
                <span class="highlight-facility"><lookup complexExpression="$fn.formatDate($patient.deathDate, 'dd MMM yyyy HH:mm a')"/></span>
            </p>
        </div>
    </section>

    <section id="overview" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Overview">
        <div class="section-container">

            <p class="side-by-side">
                <label>
                    <uimessage code="Preventable death"/>
                </label>
                <obs conceptId="PIH:21659" style="radio"
                     answerConceptIds="CIEL:1065,CIEL:1066"
                     answerCodes="yes,no" />
            </p>

            <p>
                <label>
                    <uimessage code="Issues affecting quality"/>
                </label>
                <repeat>
                    <template>
                        <obs conceptId="PIH:21660" style="checkbox"
                             answerConceptId="PIH:{issue}" />
                    </template>

                    <render issue="21661" desc="Inaccuracy of notes" />
                    <render issue="21662" desc="Time" />
                    <render issue="21663" desc="Key staff absent" />
                    <render issue="21664" desc="Adherence to protocol/guidelines" />
                    <render issue="5622" desc="Other" />
                </repeat>

                <label>
                    <uimessage code="if other, specify issues affecting quality care:" />
                </label>
                <obs conceptId="PIH:21665" />
            </p>

            <p>
                <label>
                    <uimessage code="History (including prior facility admissions)"/>
                </label>
                <obs conceptId="PIH:10142" style="textarea" />
            </p>

            <p>
                <label>
                    <uimessage code="Possible contributing factors to death (3 Delays): "/>
                </label>
                <repeat>
                    <template>
                        <obs conceptId="PIH:21667" style="checkbox"
                             answerConceptId="PIH:{factor}" />
                    </template>

                    <render factor="21668" desc="Deciding to seek care" />
                    <render factor="21669" desc="Reaching care" />
                    <render factor="21670" desc="Receiving adequate care" />
                </repeat>
            </p>

            <p>
                <label>
                    <uimessage code="What could have been done to prevent this death?"/>
                </label>
                <obs conceptId="PIH:21666" style="textarea" />
            </p>

            <p>
                <strong>
                    <uimessage code="Underlying causes of death"/>
                </strong>
                <div class="three-columns">
                    <div>
                        <label>
                            <uimessage code="Primary" />
                        </label>
                        <span id="primaryCause">
                            <obsgroup groupingConceptId="PIH:21678"
                                      showIfEmpty="false">
                                <obs conceptId="PIH:Underlying cause of death"
                                     answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete" controlId="primeCause" />
                                <span class="small hidden">
                                    <obs conceptId="CIEL:159946" defaultValue="PIH:primary" controlId="primary"/>
                                </span>
                            </obsgroup>
                        </span>
                    </div>
                    <div>
                        <label>
                            <uimessage code="Secondary" />
                        </label>
                        <span id="secondaryCause">
                            <obsgroup groupingConceptId="PIH:21678"
                                      showIfEmpty="false">
                                <obs conceptId="PIH:Underlying cause of death"
                                     answerClasses="Diagnosis,Finding,Symptom,Symptom/Finding" style="autocomplete" controlId="secondCause" />
                                <span class="small hidden">
                                    <obs conceptId="CIEL:159946" defaultValue="PIH:secondary" controlId="secondary"/>
                                </span>
                            </obsgroup>
                        </span>
                    </div>
                    <div></div>
                </div>

            </p>

        </div>
    </section>

    <style>
        th {
            background-color: #bbbbbb;
            color: #555555;
        }
    </style>

    <section id="actionPts" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Action points">
        <div class="section-container">
            <table>
                <tr>
                    <th rowspan="2">S/N</th>
                    <th rowspan="2">Action item</th>
                    <th rowspan="2">Responsible person</th>
                    <th colspan="2">Timeline</th>
                </tr>
                <tr>
                    <th>Start</th>
                    <th>End</th>
                </tr>
                <repeat with="['1'],['2'],['3']">
                    <span id="action-{0}" >
                        <obsgroup groupingConceptId="PIH:21673" showIfEmpty="false" >
                            <tr>
                                <td>
                                    {0}
                                    <span class="small hidden">
                                        <obs id="action-order-{0}" conceptId="CIEL:165416" defaultValue="{0}" controlId="order-{0}"/>
                                    </span>
                                </td>
                                <td>
                                    <obs conceptId="PIH:21672" controlId="action-desc-{0}" style="text"/>
                                </td>
                                <td>
                                    <obs conceptId="PIH:6592" controlId="action-person-{0}" style="text"/>
                                </td>
                                <td>
                                    <obs conceptId="PIH:11131" controlId="s-date-{0}" allowFutureDates="true"/>
                                </td>
                                <td>
                                    <obs conceptId="PIH:12748" controlId="e-date-{0}" allowFutureDates="true"/>
                                </td>
                            </tr>
                        </obsgroup>
                    </span>
                </repeat>
            </table>
        </div>
    </section>

    <br/>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel"><uimessage code="emr.cancel"/></button>
        </div>
    </ifMode>

</htmlform>
