    <script type="text/javascript">

        function calculatePostDuctDiff() {
            const preductalVal = jq('#preDuctalO2 input[type="text"]').val();
            const postductalVal = jq('#postDuctalO2 input[type="text"]').val();
            if ( preductalVal &amp;&amp; postductalVal &amp;&amp; (preductalVal != null) &amp;&amp; !(Number.isNaN(preductalVal)) &amp;&amp; (postductalVal != null) &amp;&amp; !(Number.isNaN(postductalVal))) {
                let preductNumeric = Number(preductalVal);
                let postductalNumeric = Number(postductalVal);
                let postDuctDiff = preductNumeric - postductalNumeric;
                jq('#postductalDifference').val(postDuctDiff);
                if ( postDuctDiff &gt; 5) {
                    jq('#postductalDifference').addClass('triage-label-red');
                } else {
                    jq('#postductalDifference').removeClass('triage-label-red');
                }
            }
        }

        function viewPostDuctDiff() {
            const preductalVal = jq('#preDuctalO2 .value').text();
            const postductalVal = jq('#postDuctalO2 .value').text();
            if ( preductalVal &amp;&amp; postductalVal &amp;&amp; (preductalVal != null) &amp;&amp; !(Number.isNaN(preductalVal)) &amp;&amp; (postductalVal != null) &amp;&amp; !(Number.isNaN(postductalVal))) {
                let preductNumeric = Number(preductalVal);
                let postductalNumeric = Number(postductalVal);
                let postDuctDiff = preductNumeric - postductalNumeric;
                jq('#postductalDifference').text(postDuctDiff);
                if ( postDuctDiff &gt; 5) {
                    jq('#postductalDiffDiv').addClass('triage-label-red');
                } else {
                    jq('#postductalDiffDiv').removeClass('triage-label-red');
                }
            }
        }

        jq(document).ready(function() {

        jq('.normalObs').change(function(event) {
            // get the Obs checkbox value
            var firstCheckbox = jq(this).children(":checkbox:first").prop('checked');
            if (firstCheckbox == true) {
                var parentDiv = jq(this).closest('.exam');
                if (parentDiv != null) {
                    jq(parentDiv).find('.abnormalObs').each(function(index, element) {
                        jq(this).children(":checkbox:first").prop('checked', false);
                    });
                }
            }
        });

        jq('.abnormalObs').change(function(event) {
            var firstCheckbox = jq(this).children(":checkbox:first").prop('checked');
            if (firstCheckbox == true) {
                var parentDiv = jq(this).closest('.exam');
                if (parentDiv != null) {
                    jq(parentDiv).find('.normalObs').each(function(index, element) {
                        jq(this).children(":checkbox:first").prop('checked', false);
                    });
                }
            }
        });

        jq('.o2SatValue input[type="text"]').on('change', function() {
            calculatePostDuctDiff();
        });

        calculatePostDuctDiff();
        viewPostDuctDiff();

        // handlers for next and submit buttons, see nextAndSubmitButtons.js
        setUpNextAndSubmitButtons();

        });
    </script>


