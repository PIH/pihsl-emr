<htmlform formUuid="2db3e8df-f950-493f-85b2-90a9477cd02f"
          formName="AYFS Followup"
          formEncounterType="73399721-644e-494b-86c9-5dd345072db3"
          formVersion="1.0">

    <postSubmissionAction class="org.openmrs.module.pihcore.htmlformentry.action.ApplyDispositionAction"/>
    <postSubmissionAction class="org.openmrs.module.pihcore.htmlformentry.action.CleanDiagnosisConstructAction" />

    <style type="text/css">
        #condom-method .condom-row {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 5px;
        }
        #condom-method .condom-row > span:first-child {
            display: flex;
            align-items: center;
            min-width: 160px;
        }
        #condom-method .condom-row input[type="checkbox"] {
            float: none;
        }
        #condom-method .condom-row label {
            display: inline;
            width: auto;
        }
        #condom-method .condom-row input[type="text"] {
            display: inline-block;
            margin: 0 5px 0 0;
        }
        #condom-method .condom-row .value + .units {
            margin-left: 5px;
        }
    </style>

    <script type="text/javascript">

        jq(function() {
            // handlers for next and submit buttons, see nextAndSubmitButtons.js
            setUpNextAndSubmitButtons();
        });

    </script>

    <ifMode mode="VIEW" include="false">
        <h2>
            <label>
                <uimessage code="AYFS Followup"/>
            </label>
        </h2>
    </ifMode>

    <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
        <span subform-parameter="encounter-location-widget">
            <encounterLocation default="SessionAttribute:emrContext.sessionLocationId"
                               tags="Maternal and Child Location"/>
        </span>
        <span subform-parameter="encounter-provider-widget">
            <encounterProviderAndRole default="currentUser"
                                      encounterRole="4f10ad1a-ec49-48df-98c7-1391c6ac7f05"
                                      providerRoles="${providerGroup.group2}"
                                      required="true"/>
        </span>
    </subform>

    <section id="gbv" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="GBV screening">
        <div class="section-container">
            <p>
                <label>
                    <i>
                        <uimessage code="Note: ‘Anyone’ may include your partner, a family member,
        friend, neighbor, a client, stranger, supervisor, colleague, police officer or other persons." />
                    </i>
                </label>
            </p>

            <p class="list-inline-extra-wide">
                <label>
                    <uimessage code="Has anyone hit, kicked, punched, or otherwise hurt you in the past year?" />
                </label>
                <obs conceptId="PIH:21679" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="list-inline-extra-wide">
                <label>
                    <uimessage code="Has anyone insulted you, ignored you, yelled at you or made you feel ashamed or
bad about yourself in the past year?" />
                </label>
                <obs conceptId="PIH:21680" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="list-inline-extra-wide">
                <label>
                    <uimessage code="Has anyone forced you to have sex, or perform any sexual act or touched you
sexually in any way that you did not want in the past year?" />
                </label>
                <obs conceptId="PIH:21681" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="list-inline-extra-wide">
                <label>
                    <uimessage code="Has anyone made you feel afraid, unsafe or in danger in the past year?" />
                </label>
                <obs conceptId="PIH:21682" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>
        </div>
    </section>

    <section id="visit-reason" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Reason for visit">
        <div class="section-container">

            <repeat>
                <template>
                        <obs id="vr-{tID}" conceptId="CIEL:167788" style="checkbox"
                             answerConceptId="{acID}"
                             answerCode="{csName}" />
                </template>
                <render acID="PIH:FAMILY PLANNING" tID="fp" csName="Family planning" />
                <render acID="PIH:ANTENATAL CLINIC" tID="anc" csName="ANC" />
                <render acID="PIH:SEXUALLY TRANSMITTED INFECTION PROGRAM" tID="sti" csName="STI screening and management" />
                <render acID="CIEL:159940" tID="vct" csName="HIV test and counseling" />
                <render acID="PIH:21701" tID="tomi" csName="Treatment of minor illness" />
                <render acID="PIH:21700" tID="ghe" csName="General health education" />
            </repeat>

            <!-- Only the "other" checkbox controls the specify box: a <when> on every checkbox hid the box (and dropped its text) when another reason was ticked -->
            <obs id="vr-other" conceptId="CIEL:167788" style="checkbox"
                 answerConceptId="CIEL:5622"
                 answerCode="other">
                <controls>
                    <when value="CIEL:5622" thenDisplay="#other-visit-reason" />
                </controls>
            </obs>

            <div id="other-visit-reason">
                <obs conceptId="CIEL:160430" style="textarea" labelCode="if other, specify reason for the visit" />
            </div>

        </div>
    </section>

    <section id="fp-method" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Family planning method">
        <div class="section-container">
            <div>

                <div class="two-columns">
                    <div id="coc-pop-method">
                        <p>
                            <strong>
                                <uimessage code="Combined oral contraceptive (COC)"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:104625" dID="104625" csName="Microgynon" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:159783"
                                     answerCode="Other combined oral contraceptive (COC)"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>

                        <p>
                            <strong>
                                <uimessage code="Progestin-only orals"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:78796"  dID="78796" csName="Microlut" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:80784"
                                     answerCode="Other progestin-only pill (POP)"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>
                    </div>
                    <div id="injectables-iud-method">
                        <p>
                            <strong>
                                <uimessage code="Injectables"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:907"    dID="907" csName="Depo-provera" />
                                <render acID="PIH:21450"   dID="21450" csName="Sayana press" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:5279"
                                     answerCode="Other injectable contraceptive"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>

                        <p>
                            <strong>
                                <uimessage code="Intrauterine Contraceptive Device (IUCD)"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="PIH:21478"   dID="21478"  csName="Copper T IUD" />
                                <render acID="CIEL:165464" dID="165464" csName="Hormonal IUD" />
                            </repeat>
                        </p>
                    </div>
                </div>

                <div>
                    <div id="implant-method" class="two-columns">
                        <div>
                            <p>
                                <strong>
                                    <uimessage code="Implants"/>
                                </strong>

                                <repeat>
                                    <template>
                                        <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                            <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                                 answerConceptId="{acID}"
                                                 answerCode="{csName}">
                                                <controls>
                                                    <when value="CIEL:1873" thenDisplay="#implant-date"/>
                                                    <when value="CIEL:5275" thenDisplay="#implant-date"/>
                                                </controls>
                                            </obs>
                                        </obsgroup>
                                    </template>
                                    <render acID="CIEL:1873"   dID="1873" csName="Jadelle" />
                                    <render acID="CIEL:76022"  dID="76022" csName="Implanon" />
                                    <render acID="PIH:21756"  dID="21756" csName="Levoplant" />
                                </repeat>
                                <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                    <obs conceptId="CIEL:374" style="checkbox"
                                         answerConceptId="CIEL:162422"
                                         answerCode="Other implant"
                                         showCommentField="true" commentFieldLabel="specify:">
                                    </obs>
                                </obsgroup>
                            </p>
                        </div>

                        <div id="implant-date">
                            <label>
                                <uimessage code="pihcore.dateImplant"/>:
                            </label>
                            <obs conceptId="PIH:3203" />
                        </div>
                    </div>

                    <div id="condom-method">
                        <div>
                            <strong>
                                <uimessage code="Condom"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <div class="condom-row">
                                            <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                                 answerConceptId="{acID}"
                                                 answerCode="{csName}">
                                            </obs>
                                            <obs id="no-of-condoms-{noCondoID}" conceptId="PIH:{noCondoID}" showUnits="condoms" />
                                        </div>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:164813" dID="164813" csName="Male condom" noCondoID="21757"/>
                                <render acID="CIEL:164814" dID="164814" csName="Female condom" noCondoID="21758"/>
                            </repeat>
                        </div>
                    </div>
                </div>
            </div>

            <includeIf velocityTest="$patient.gender == 'F' ">
                <div>
                    <p>
                        <strong>
                            <uimessage code="Other contraceptive methods"/>
                        </strong>
                        <obs conceptId="CIEL:160693" style="checkbox"
                             answerConceptId="CIEL:160570">
                        </obs>
                    </p>
                </div>
            </includeIf>

            <div>
                <p>
                    <strong>
                        <uimessage code="Other family planning method"/>
                    </strong>
                    <label>
                        <uimessage code="specify other method"/>
                    </label>
                    <obs conceptId="PIH:2996" style="text" />
                </p>
            </div>
        </div>
    </section>

    <section id="sti-screen" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="STI Screening">
        <div class="section-container">

            <div>
                <p class="side-by-side">
                    <label>
                        <uimessage code="Sexual partner?" />
                    </label>
                    <obs conceptId="CIEL:160109" style="radio"
                         answerConceptIds="CIEL:1065,CIEL:1066"
                         answerCodes="yes,no" />
                </p>
            </div>
            <div>
                <p class="side-by-side">
                    <label>
                        <uimessage code="Unprotected sexual contact within the past month?" />
                    </label>
                    <obs conceptId="CIEL:159218" style="radio"
                         answerConceptIds="CIEL:1065,CIEL:1066"
                         answerCodes="yes,no" />
                </p>
            </div>

            <div>
                <p class="side-by-side">
                    <label>
                        <uimessage code="Symptoms/problems around the genitalia?" />
                    </label>
                    <obs conceptId="CIEL:1126" style="radio"
                         answerConceptIds="CIEL:1116,CIEL:1115"
                         answerCodes="yes,no" />
                </p>
            </div>
        </div>
    </section>

    <section id="rapid-tests" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Laboratory tests">
        <div class="section-container">
            <h3>
                <uimessage code="Rapid Tests" />
            </h3>
            <subform path="configuration/pih/subforms/rapid-tests-widget.xml"/>

            <h3>
                <uimessage code="Lab Orders" />
            </h3>
            <pihLabOrder />

        </div>
    </section>

    <section id="diagnosis" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Diagnosis">
        <div class="section-container">

            <div id="data-collection">
                <encounterDiagnosesByObs selectedDiagnosesTarget="#encounter-diagnoses-target"/>

                <p>
                    <label>
                        <uimessage code="emr.consult.freeTextComments"/>
                    </label>
                    <obs conceptId="PIH:CLINICAL IMPRESSION COMMENTS" style="textarea" rows="5"/>
                </p>
            </div>

            <div id="encounter-diagnoses-target">
            </div>
            <br/><br/>

            <div class="two-columns">
                <div>
                    <p id="ayfs-dx" class="side-by-side">
                        <strong>
                            <uimessage code="Common diagnoses" />
                        </strong>

                        <repeat>
                            <template>
                                <obsgroup groupingConceptId="PIH:Visit Diagnoses" showIfEmpty="false">
                                    <obs conceptId="PIH:DIAGNOSIS" style="checkbox"
                                         answerConceptId="{diagId}" answerCodeXX="{name}"/>
                                </obsgroup>
                                <br/>
                            </template>
                            <render diagId="CIEL:112992" name="STI" />
                            <render diagId="CIEL:116128" name="Malaria" />
                            <render diagId="CIEL:141" name="Typhoid" />
                            <render diagId="CIEL:117703" name="Sickle-cell" />
                            <render diagId="PIH:Common cold" name="Common cold" />
                            <render diagId="CIEL:114403" name="Body pain" />
                            <render diagId="CIEL:139084" name="Headache" />
                            <render diagId="CIEL:121518" name="Appendicitis" />
                            <render diagId="PIH:7631" name="Dental" />
                            <render diagId="CIEL:149478" name="Upper respiratory tract infection" />
                            <render diagId="CIEL:111633" name="UTI" />
                            <render diagId="CIEL:150802" name="PC bleeding" />

                        </repeat>
                    </p>
                </div>
                <div>
                    <p id="sti-dx" class="side-by-side">
                        <strong>
                            <uimessage code="STI diagnoses" />
                        </strong>

                        <repeat>
                            <template>
                                <obsgroup groupingConceptId="PIH:Visit Diagnoses" showIfEmpty="false">
                                    <obs conceptId="PIH:DIAGNOSIS" style="checkbox"
                                         answerConceptId="{diagId}" answerCodeXX="{name}"/>
                                </obsgroup>
                                <br/>
                            </template>
                            <render diagId="CIEL:112493" name="Syphilis" />
                            <render diagId="CIEL:139505" name="Genital warts" />
                            <render diagId="CIEL:118771" name="Dysuria" />
                            <render diagId="CIEL:137155" name="Inguinal bubo" />
                            <render diagId="CIEL:125203" name="Scrotal swelling" />
                            <render diagId="CIEL:157544" name="Lower abdominal pain" />
                            <render diagId="CIEL:123529" name="Urethral discharge syndrome" />
                            <render diagId="PIH:GENITAL SORES" name="Genital ulcer" />
                            <render diagId="CIEL:123395" name="Vaginal discharge syndrome" />
                            <render diagId="CIEL:148654" name="Anorectal infections" />
                        </repeat>

                    </p>
                </div>
            </div>

        </div>
    </section>

    <section id="drug-orders" sectionTag="fieldset"
             headerTag="legend" headerStyle="title" headerCode="pihcore.visitNote.orders.medications">
        <div class="section-container">
            <subform path="configuration/pih/subforms/drug-order-widget.xml"/>
        </div>
    </section>

    <section id="outcome-section" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Outcome">
        <div class="section-container">
            <div class="two-columns">
                <div>
                    <div id="disposition">
                        <encounterDisposition id="encounter-disposition" />
                    </div>
                </div>

                <div>
                    <p>
                        <label>
                            <uimessage code="Next appointment date"/>
                        </label>
                        <obs id="apptDate" conceptId="PIH:RETURN VISIT DATE"
                             allowFutureDates="true" allowPastDates="false"
                             required="false"/>
                    </p>

                    <p>
                        <label>
                            <uimessage code="Referred to:"/>
                        </label>

                        <repeat>
                            <template>
                                <obs conceptId="CIEL:1272" style="checkbox"
                                     answerConceptId="{aCId}"
                                     answerCodesXX="{nameLabel}"/>
                            </template>
                            <render aCId="CIEL:168363" nameLabel="NCD" />
                            <render aCId="CIEL:168362" nameLabel="TB/HIV" />
                            <render aCId="PIH:OUTPATIENT CONSULTATION" nameLabel="OPD" />
                            <render aCId="PIH:7831" nameLabel="Gynea clinic" />
                            <render aCId="PIH:MENTAL HEALTH SERVICES" nameLabel="Mental health" />
                            <render aCId="PIH:20638" nameLabel="Rainbow clinic" />
                            <render aCId="PIH:21714" nameLabel="Dabunde Sickle Clinic" />
                            <render aCId="CIEL:5622" nameLabel="other" />
                        </repeat>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>

</htmlform>
