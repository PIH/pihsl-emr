<htmlform formUuid="ec502050-c987-4aad-8ca5-628fd7871233"
          formName="Family Planning Followup"
          formEncounterType="5a1d1710-98b0-4e5f-8f6b-c9cef0c8cf05"
          formVersion="1.1">

    <postSubmissionAction class="org.openmrs.module.pihcore.htmlformentry.action.ReopenVisitAction"/>

    <style type="text/css">
        /* View mode: "Other: specified text" (Method switch and Social support) */
        .ms-comment::before { content: ": "; }
        /* Method switch details (SL-1518/SL-1519) */
        #method-switch-details { margin: 0.25em 0 0.75em 1.5em; padding-top: 0.5em; border-top: 1px solid #ddd; }
        #method-switch-details .ms-columns { display: flex; gap: 2em; }
        #method-switch-details .ms-columns > div { flex: 1; }
        #method-switch-details .ms-heading { margin: 0.5em 0 0.25em 0; }
        #method-switch-details .ms-specify { display: block; margin: 0.25em 0 0 1.75em; font-size: 0.9em; }
        #method-switch-details .ms-other input[type=text] { display: block; margin: 0.25em 0 0 1.75em; }
        #ms-removal-reason label { display: inline; }
        #ms-removal-reason input[type=radio] { margin: 0.35em 0.5em 0.35em 0.25em; }
        #condom-method .condom-row {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 5px;
        }
        #condom-method .condom-row > span:first-child {
            display: flex;
            align-items: center;
            min-width: 160px;
        }
        #condom-method .condom-row input[type="checkbox"] {
            float: none;
        }
        #condom-method .condom-row label {
            display: inline;
            width: auto;
        }
        #condom-method .condom-row input[type="text"] {
            display: inline-block;
            margin: 0 5px 0 0;
        }
        #condom-method .condom-row .value + .units {
            margin-left: 5px;
        }
    </style>

    <script type="text/javascript">

        jq(function() {
            // handlers for next and submit buttons, see nextAndSubmitButtons.js
            setUpNextAndSubmitButtons();
        });

    </script>

    <ifMode mode="VIEW" include="false">
        <h2>
            <label>
                <uimessage code="Family Planning Followup"/>
            </label>
        </h2>
    </ifMode>

    <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
        <span subform-parameter="encounter-location-widget">
            <encounterLocation default="SessionAttribute:emrContext.sessionLocationId"
                               tags="Maternal and Child Location"/>
        </span>
        <span subform-parameter="encounter-provider-widget">
            <encounterProviderAndRole default="currentUser"
                                      encounterRole="4f10ad1a-ec49-48df-98c7-1391c6ac7f05"
                                      providerRoles="${providerGroup.group2}"
                                      required="true"/>
        </span>
    </subform>

    <!-- Family planning client type (SL-1518): PIH:14321 "Family planning service status", as on the OB/GYN initial form:
         PIH:13958 "Accepted" = first time user (new acceptor), CIEL:965 "Currently using birth control" = continuing user -->
    <section id="fp-client-type" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Family planning client type">
        <div class="section-container">
            <p class="list-inline-wide">
                <obs conceptId="PIH:14321" style="radio"
                     answerConceptIds="PIH:13958,CIEL:965"
                     answerCodes="First time family planning user,Continuing family planning user"/>
            </p>
        </div>
    </section>

    <section id="disability" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Disability">
        <div class="section-container">
            <repeat>
                <template>
                    <obs conceptId="CIEL:162558" style="checkbox"
                         answerConceptId="{concept}" answerCodeXX="{name}"/>
                </template>
                <render concept="PIH:21469"   name="Physical disability" />
                <render concept="CIEL:159298" name="Visual impairment" />
                <render concept="CIEL:112846" name="Speech and language impairment" />
                <render concept="CIEL:139075" name="Hearing impairment" />
                <render concept="CIEL:153343" name="Learning impairment" />
                <render concept="PIH:21470"   name="Multiple" />
            </repeat>
        </div>
    </section>

    <section id="vitals" sectionTag="fieldset" headerTag="legend"
             headerStyle="title" headerCode="pihcore.vitalSigns">
        <div class="section-container">
            <subform path="configuration/pih/subforms/prior-vital-signs-widget.xml"/>
            <br/>
            <subform path="configuration/pih/subforms/vital-signs-wt-ht-bp-widget.xml"/>
        </div>
    </section>

    <section id="service" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Service type">
        <div class="section-container">
            <!-- Method switch shows the previous method, side effects and removal reason (SL-1518/SL-1519) -->
            <obs id="svc-method-switch" conceptId="PIH:13236" style="checkbox"
                 answerConceptId="CIEL:163494" answerCode="Method switch">
                <controls>
                    <when value="CIEL:163494" thenDisplay="#method-switch-details" />
                </controls>
            </obs>

            <div id="method-switch-details">
                <div class="ms-columns">
                    <div>
                        <p class="ms-heading"><uimessage code="Previous method" /></p>
                        <repeat>
                            <template>
                                <div><obs conceptId="PIH:21857" style="checkbox"
                                          answerConceptId="{concept}" answerCode="{name}" /></div>
                            </template>
                            <render concept="PIH:13249" name="Combined oral contraceptive (COC)" />
                            <render concept="PIH:21850" name="Progestin-only pill (POP)" />
                            <render concept="CIEL:5277" name="Natural (Rhythm)" />
                            <render concept="PIH:190"   name="Condoms" />
                            <render concept="PIH:907"   name="Depo-provera" />
                            <render concept="PIH:21450" name="Sayana press" />
                            <render concept="PIH:5275"  name="IUD" />
                            <render concept="PIH:20955" name="Implant" />
                            <render concept="PIH:1719"  name="Tubal ligation" />
                            <render concept="PIH:13158" name="Exclusive breastfeeding (requires a secondary method)" />
                        </repeat>
                    </div>
                    <div>
                        <p class="ms-heading"><uimessage code="Side effects" /></p>
                        <repeat>
                            <template>
                                <div><obs conceptId="PIH:1297" style="checkbox"
                                          answerConceptId="{concept}" answerCode="{name}" /></div>
                            </template>
                            <render concept="PIH:7253"  name="Irregular bleeding" />
                            <render concept="PIH:21851" name="Prolonged bleeding" />
                            <render concept="PIH:7617"  name="Amenorrhea" />
                            <render concept="PIH:21645" name="Dizziness" />
                            <render concept="PIH:5978"  name="Nausea" />
                            <render concept="PIH:21852" name="Weight change" />
                            <render concept="PIH:620"   name="Headache" />
                            <render concept="PIH:21648" name="Abdominal bloating" />
                            <render concept="PIH:151"   name="Abdominal pain" />
                            <render concept="PIH:21853" name="Breast tenderness" />
                            <render concept="PIH:838"   name="Acne" />
                            <render concept="PIH:9527"  name="Mood changes" />
                        </repeat>
                        <!-- "Other" keeps the specified text in the obs comment -->
                        <div class="ms-other"><obs id="ms-side-effect-other" conceptId="PIH:1297" style="checkbox"
                                                   answerConceptId="CIEL:5622" answerCode="Other"
                                                   commentFieldCode="Please specify" /></div>
                    </div>
                </div>

                <p class="ms-heading"><uimessage code="Removal reason" /></p>
                <!-- "Ready for pregnancy" is PIH 21847, which has only its CIEL:160571 mapping -->
                <div class="ms-other">
                    <obs id="ms-removal-reason" conceptId="PIH:21846" style="radio"
                         answerConceptIds="CIEL:160571,PIH:21858,CIEL:5622"
                         answerCodes="Ready for pregnancy,Time due,Other"
                         answerSeparator="&lt;br /&gt;"
                         commentFieldCode="Please specify" />
                </div>
            </div>

            <script type="text/javascript">
                // HFE writes the "Please specify" comment label as bare text after "Other"; wrap it so it sits on its own line under "Other"
                jq(function() {
                    jq('#ms-side-effect-other, #ms-removal-reason').contents().filter(function() {
                        return this.nodeType === 3 &amp;&amp; jq.trim(this.nodeValue) !== '';
                    }).wrap('&lt;span class="ms-specify"&gt;&lt;/span&gt;');

                    // View mode has no inputs: drop the "Please specify" label and show the text as "Other: text"
                    jq('#ms-side-effect-other, #ms-removal-reason, #support-other').each(function() {
                        var field = jq(this);
                        if (field.find('input').length === 0) {
                            var specify = field.find('.ms-specify').hide();
                            specify.next('.value').addClass('ms-comment');
                            specify.next('.emptyValue').hide();  // nothing specified: drop the blank placeholder
                        }
                    });
                });
            </script>

            <obs conceptId="PIH:13236" style="checkbox"
                 answerConceptId="PIH:14376" answerCode="Post abortion" />
        </div>
    </section>

    <section id="fp-method" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Family planning method">
        <div class="section-container">
            <div>
                <div>
                    <p class="list-inline-wide">
                        <label>
                            <uimessage code="Family planning counselling"/>
                        </label>
                        <obs conceptId="CIEL:1382" style="radio"
                             answerConceptIds="CIEL:1065,CIEL:1066"
                             answerCodes="yes,no"/>
                    </p>
                </div>

                <div class="two-columns">
                    <div id="coc-pop-method">
                        <p>
                            <strong>
                                <uimessage code="Combined oral contraceptive (COC)"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:104625" dID="104625" csName="Microgynon" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:159783"
                                     answerCode="Other combined oral contraceptive (COC)"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>

                        <p>
                            <strong>
                                <uimessage code="Progestin-only orals"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:78796"  dID="78796" csName="Microlut" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:80784"
                                     answerCode="Other progestin-only pill (POP)"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>
                    </div>
                    <div id="injectables-iud-method">
                        <p>
                            <strong>
                                <uimessage code="Injectables"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:907"    dID="907" csName="Depo-provera" />
                                <render acID="PIH:21450"   dID="21450" csName="Sayana press" />
                            </repeat>
                            <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                <obs conceptId="CIEL:374" style="checkbox"
                                     answerConceptId="CIEL:5279"
                                     answerCode="Other injectable contraceptive"
                                     showCommentField="true" commentFieldLabel="specify:">
                                </obs>
                            </obsgroup>
                        </p>

                        <p>
                            <strong>
                                <uimessage code="Intrauterine Contraceptive Device (IUCD)"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                             answerConceptId="{acID}"
                                             answerCode="{csName}">
                                        </obs>
                                    </obsgroup>
                                </template>
                                <render acID="PIH:21478"   dID="21478"  csName="Copper T IUD" />
                                <render acID="CIEL:165464" dID="165464" csName="Hormonal IUD" />
                            </repeat>
                        </p>
                    </div>
                </div>

                <div>
                    <div id="implant-method" class="two-columns">
                        <div>
                            <p>
                                <strong>
                                    <uimessage code="Implants"/>
                                </strong>

                                <repeat>
                                    <template>
                                        <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                            <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                                 answerConceptId="{acID}"
                                                 answerCode="{csName}">
                                                <controls>
                                                    <when value="CIEL:1873" thenDisplay="#implant-date"/>
                                                    <when value="CIEL:5275" thenDisplay="#implant-date"/>
                                                </controls>
                                            </obs>
                                        </obsgroup>
                                    </template>
                                    <render acID="CIEL:1873"   dID="1873" csName="Jadelle" />
                                    <render acID="CIEL:76022"  dID="76022" csName="Implanon" />
                                    <render acID="PIH:21756"  dID="21756" csName="Levoplant" />
                                </repeat>
                                <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                    <obs conceptId="CIEL:374" style="checkbox"
                                         answerConceptId="CIEL:162422"
                                         answerCode="Other implant"
                                         showCommentField="true" commentFieldLabel="specify:">
                                    </obs>
                                </obsgroup>
                            </p>
                        </div>

                        <div id="implant-date">
                            <label>
                                <uimessage code="pihcore.dateImplant"/>:
                            </label>
                            <obs conceptId="PIH:3203" />
                        </div>
                    </div>

                    <div id="condom-method">
                        <div>
                            <strong>
                                <uimessage code="Condom"/>
                            </strong>

                            <repeat>
                                <template>
                                    <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                                        <div class="condom-row">
                                            <obs id="fp-meth-{dID}" conceptId="CIEL:374" style="checkbox"
                                                 answerConceptId="{acID}"
                                                 answerCode="{csName}">
                                            </obs>
                                            <obs id="no-of-condoms-{noCondoID}" conceptId="PIH:{noCondoID}" showUnits="condoms" />
                                        </div>
                                    </obsgroup>
                                </template>
                                <render acID="CIEL:164813" dID="164813" csName="Male condom" noCondoID="21757"/>
                                <render acID="CIEL:164814" dID="164814" csName="Female condom" noCondoID="21758"/>
                            </repeat>
                        </div>
                    </div>
                </div>


            </div>

            <includeIf velocityTest="$patient.gender == 'F' ">
                <div>
                    <p>
                        <strong>
                            <uimessage code="Other contraceptive methods"/>
                        </strong>
                        <obs conceptId="CIEL:160693" style="checkbox"
                             answerConceptId="CIEL:160570">
                        </obs>
                    </p>
                </div>
            </includeIf>

            <div>
                <p>
                    <strong>
                        <uimessage code="Permanent method"/>
                    </strong>
                    <includeIf velocityTest="$patient.gender == 'F' ">
                        <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                            <obs conceptId="CIEL:374" style="checkbox"
                                 answerConceptId="CIEL:1472">
                            </obs>
                        </obsgroup>
                    </includeIf>
                    <includeIf velocityTest="$patient.gender == 'M' ">
                        <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                            <obs conceptId="CIEL:374" style="checkbox"
                                 answerConceptId="CIEL:1489">
                            </obs>
                        </obsgroup>
                    </includeIf>
                </p>
            </div>

            <div>
                <p>
                    <strong>
                        <uimessage code="Other family planning method"/>
                    </strong>
                    <includeIf velocityTest="$patient.gender == 'F' ">
                        <obsgroup groupingConceptId="PIH:Family planning construct" showIfEmpty="false">
                            <obs conceptId="CIEL:374" style="checkbox"
                                 answerConceptId="CIEL:136163"
                                 answerCode="Lactation amenorrhea method (LAM)" />
                        </obsgroup>
                    </includeIf>
                    <label>
                        <uimessage code="specify other method"/>
                    </label>
                    <obs conceptId="PIH:2996" style="text" />
                </p>
            </div>
        </div>
    </section>

    <section id="additional" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Additional information">
        <div class="section-container">
            <div>
                <div>
                    <p>
                        <label>
                            <uimessage code="Date of next appointment"/>
                        </label>
                        <span class="small">
                            <obs id="apptDate"
                                 conceptId="PIH:RETURN VISIT DATE"
                                 allowFutureDates="true" allowPastDates="false" />
                        </span>
                    </p>
                </div>

                <p class="list-inline-wide">
                    <label>
                        <uimessage code="Referred out to other facility" />
                    </label>
                    <obs conceptId="PIH:6547" style="radio"
                         answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no" />
                </p>
            </div>
        </div>
    </section>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>

</htmlform>
