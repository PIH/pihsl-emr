            <script type="text/javascript">
                // HFE writes the "Please specify" comment label as bare text after "Other"; wrap it so it sits on its own line under "Other"
                jq(function() {
                    jq('#ms-side-effect-other, #ms-removal-reason, #support-other').contents().filter(function() {
                        return this.nodeType === 3 &amp;&amp; jq.trim(this.nodeValue) !== '';
                    }).wrap('&lt;span class="ms-specify"&gt;&lt;/span&gt;');

                    // View mode has no inputs: drop the "Please specify" label and show the text as "Other: text"
                    jq('#ms-side-effect-other, #ms-removal-reason, #support-other').each(function() {
                        var field = jq(this);
                        if (field.find('input').length === 0) {
                            var specify = field.find('.ms-specify').hide();
                            specify.next('.value').addClass('ms-comment');
                            specify.next('.emptyValue').hide();  // nothing specified: drop the blank placeholder
                        }
                    });

                    // Show each "Please specify" box only while its "Other" is selected, and clear it otherwise
                    var toggleSpecify = function(fieldId, other, triggers) {
                        if (!other.length) {
                            return;  // view mode
                        }
                        var field = jq(fieldId);
                        var toggle = function() {
                            var on = other.is(':checked');
                            field.find('.ms-specify, input[type=text]').toggle(on);
                            if (!on) {
                                field.find('input[type=text]').val('');
                            }
                        };
                        triggers.change(toggle);
                        toggle();
                    };
                    var sideEffectOther = jq('#ms-side-effect-other input[type=checkbox]');
                    toggleSpecify('#ms-side-effect-other', sideEffectOther, sideEffectOther);
                    var removalReasons = jq('#ms-removal-reason input[type=radio]');
                    toggleSpecify('#ms-removal-reason', removalReasons.last(), removalReasons);  // "Other" is the last answer

                    var supportOther = jq('#support-other input[type=checkbox]');
                    toggleSpecify('#support-other', supportOther, supportOther);
                });
            </script>

