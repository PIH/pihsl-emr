<!-- Pregnancy group -->
<p class="side-by-side">
    <label position="left">
        <uimessage code="pihcore.pregnancyProgramCohortGroup"/>
    </label>
    <obs conceptId="PIH:21747" style="radio"
         answerConceptIds="PIH:21748,PIH:21753,PIH:21754"
         answerCodes="A,B,C"/>

    <ifMode mode="VIEW" include="false">
        <lookup complexExpression="#set( $pregGroup = $fn.latestObsBeforeCurrentEncounter('PIH:21747', false) )"/>
        <includeIf velocityTest="($pregGroup) ">
            <br/>
            <span style="color:grey; font-style: italic;">
                <label>
                    <uimessage code="pihcore.previousPregnancyProgramCohortGroup"/>:
                </label>
                <lookup complexExpression="$pregGroup.valueCoded.name"/>
            </span>
        </includeIf>
    </ifMode>
</p>
